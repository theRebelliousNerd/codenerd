{
  "hooks": {
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/inject-subagent-memory-context.py\"",
            "commandWindows": "powershell -NoProfile -Command \"python (Join-Path (git rev-parse --show-toplevel) '.codex/hooks/inject-subagent-memory-context.py')\"",
            "timeout": 10,
            "statusMessage": "Loading shared agent memory"
          }
        ]
      },
      {
        "matcher": "^corpus[-_].*",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File .codex/hooks/corpus-build/corpus-fleet-start.ps1",
            "commandWindows": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"& (Join-Path (git rev-parse --show-toplevel) '.codex/hooks/corpus-build/corpus-fleet-start.ps1')\"",
            "timeout": 10,
            "statusMessage": "Recording corpus-build dispatch"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "^corpus[-_].*",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File .codex/hooks/corpus-build/corpus-token-meter.ps1",
            "commandWindows": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"& (Join-Path (git rev-parse --show-toplevel) '.codex/hooks/corpus-build/corpus-token-meter.ps1')\"",
            "timeout": 30,
            "statusMessage": "Recording corpus-build completion"
          }
        ]
      }
    ]
  }
}

