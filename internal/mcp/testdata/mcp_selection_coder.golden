#   web/fetch     40 base + 10 domain(/general) = 50        -> /condensed
#   fs/flaky      45 base + 10 domain(/general) - 20 usage = 35 -> /minimal
#   dead/thing    server status /error -> not available     -> absent
mcp_tool_selected(/coder, "fs/read_file", /full).
mcp_tool_selected(/coder, "fs/write_file", /full).
mcp_tool_selected(/coder, "fs/proven", /full).
